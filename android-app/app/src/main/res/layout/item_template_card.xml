<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 图片区域 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <!-- 模版预览图 -->
            <ImageView
                android:id="@+id/templateImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E0E0E0"
                android:scaleType="centerCrop" />

            <!-- AI标签 -->
            <TextView
                android:id="@+id/aiBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/ai_badge_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="AI"
                android:textColor="@android:color/black"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 使用量标签 -->
            <TextView
                android:id="@+id/usageTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/usage_tag_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- 直播标识 -->
            <View
                android:id="@+id/liveBadge"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/live_dot"
                android:visibility="gone" />

        </FrameLayout>

        <!-- 内容信息区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 标题 -->
            <TextView
                android:id="@+id/templateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="模版标题"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 作者和操作区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 作者信息 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 作者头像 -->
                    <ImageView
                        android:id="@+id/authorAvatar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/circle_avatar_background"
                        android:layout_marginEnd="4dp" />

                    <!-- 作者名称 -->
                    <TextView
                        android:id="@+id/authorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="作者名"
                        android:textColor="@color/gray_text"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- 操作按钮区域 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 修同款按钮 -->
                    <TextView
                        android:id="@+id/actionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/action_button_background"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="修同款"
                        android:textColor="@android:color/black"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <!-- 点赞按钮 -->
                    <ImageView
                        android:id="@+id/likeButton"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_heart_outline"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- 点赞数 -->
                    <TextView
                        android:id="@+id/likeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="223"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView> 