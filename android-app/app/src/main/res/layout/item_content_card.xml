<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 图片区域 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <!-- 主图片 -->
            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#F0F0F0" />

            <!-- 使用量标签 (仅部分卡片显示) -->
            <TextView
                android:id="@+id/tv_usage_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用量1234"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:background="#B3000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:visibility="gone" />

            <!-- AI标签 (仅部分卡片显示) -->
            <LinearLayout
                android:id="@+id/layout_ai_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#B0F917"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI"
                    android:textSize="8sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- LIVE标志 (仅部分卡片显示) -->
            <LinearLayout
                android:id="@+id/layout_live_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F5F5F5"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:visibility="gone">

                <!-- LIVE指示圆点 -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#FF0000"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="2dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#FF0000"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="2dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#FF0000"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

        </FrameLayout>

        <!-- 内容信息区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 标题文本 -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="超自然精致伪素颜超好看！！"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#CC000000"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="8dp" />

            <!-- 底部用户信息和操作区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 用户信息 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 用户头像 -->
                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="#E0E0E0"
                        android:scaleType="centerCrop" />

                    <!-- 用户名 -->
                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aarttion"
                        android:textSize="11sp"
                        android:textColor="#80000000"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

                <!-- 操作区域 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="22dp">

                    <!-- 修同款按钮 (仅部分卡片显示) -->
                    <TextView
                        android:id="@+id/btn_copy_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="修同款"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:background="#E0E0E0"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:visibility="gone" />

                    <!-- 点赞区域 -->
                    <LinearLayout
                        android:id="@+id/layout_like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- 点赞图标 -->
                        <ImageView
                            android:id="@+id/iv_like"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/btn_star"
                            android:tint="#80000000" />

                        <!-- 点赞数 -->
                        <TextView
                            android:id="@+id/tv_like_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="223"
                            android:textSize="12sp"
                            android:textColor="#80000000"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView> 