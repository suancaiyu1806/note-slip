<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 封面图片区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="524dp"
        android:layout_marginBottom="12dp">

        <!-- 主图片 -->
        <ImageView
            android:id="@+id/iv_main_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#F0F0F0"
            android:src="@drawable/default_image" />

        <!-- 对比图片（可选显示） -->
        <ImageView
            android:id="@+id/iv_compare_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:src="@drawable/default_image" />

        <!-- 对比按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp">

            <Button
                android:id="@+id/btn_compare"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_compare_button"
                android:drawableTop="@drawable/ic_compare"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

    <!-- 文本内容区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一键Get你的专属虚拟偶像"
            android:textSize="16sp"
            android:textColor="#000000"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- 话题标签区域 -->
        <LinearLayout
            android:id="@+id/ll_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 话题标签1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tag"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_hashtag"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="古早低像素氛围感"
                    android:textSize="14sp"
                    android:textColor="#2B5C0C"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- 话题标签2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tag"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_hashtag"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OOTD今天这么穿"
                    android:textSize="14sp"
                    android:textColor="#2B5C0C"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout> 