<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF393B3A">

    <!-- 可滚动内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="136dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 功能展示头图区域 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="330dp">

                <!-- 关闭按钮 -->
                <ImageView
                    android:id="@+id/btn_close"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@android:color/white" />

                <!-- 功能标题和描述 -->
                <LinearLayout
                    android:layout_width="168dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <!-- 功能标题 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="潮流染发"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- 功能描述 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:text="黑科技染发，不爆顶，无补根，潮流发色，立即拥有"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                </LinearLayout>

            </RelativeLayout>

            <!-- 功能工具栏 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#1A000000">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="16dp" />

            </FrameLayout>

            <!-- VIP套餐选择区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- 标题 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text="成为醒图VIP"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />

                <!-- VIP套餐选项 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_vip_packages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <!-- 续费说明 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.6"
                    android:gravity="center"
                    android:text="次月起¥18/月·自动续期·可取消"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <!-- 提示信息 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text="正在使用付费模板,开通会员解锁所有特权"
                    android:textColor="#99000000"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 法律及协议信息区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- 订阅须知 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.6"
                    android:text="确认购买后,您的签约账户将被收取费用,订阅将会在当前前订阅结束前24小时内自动续订并扣费。您可以随时关闭自动续费,退订流程:醒图->我的->VIP角标->续费管取消。"
                    android:textColor="@android:color/black"
                    android:textSize="9sp" />

                <!-- 功能链接 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_remove_effect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="移除效果"
                        android:textColor="@android:color/black"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="10dp"
                        android:alpha="0.1"
                        android:background="@android:color/black" />

                    <TextView
                        android:id="@+id/tv_member_agreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="会员协议"
                        android:textColor="@android:color/black"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="10dp"
                        android:alpha="0.1"
                        android:background="@android:color/black" />

                    <TextView
                        android:id="@+id/tv_already_vip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="⚠️我已是VIP"
                        android:textColor="@android:color/black"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="50dp">

        <!-- 同意协议 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_agreement"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:alpha="0.6"
                android:text="已阅读并同意"
                android:textColor="@android:color/black"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:text="会员协议"
                android:textColor="@android:color/black"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 订阅按钮 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_subscribe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/black"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="立即订阅"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥12"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Home指示器 -->
        <View
            android:layout_width="134dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@android:color/black" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 