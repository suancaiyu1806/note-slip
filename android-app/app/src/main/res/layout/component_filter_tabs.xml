<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/filter_tab_height"
    android:background="@color/background_light">

    <!-- 精选标签 -->
    <LinearLayout
        android:id="@+id/tab_selected"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tv_tab_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="精选"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/filter_tab_text_size"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <!-- 激活下划线 -->
        <View
            android:id="@+id/underline_selected"
            android:layout_width="@dimen/filter_underline_width"
            android:layout_height="@dimen/filter_underline_height"
            android:layout_marginTop="10dp"
            android:background="@color/primary_text" />

    </LinearLayout>

    <!-- 最新标签 -->
    <TextView
        android:id="@+id/tab_latest"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/tab_selected"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:text="最新"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/filter_tab_text_size"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground" />

    <!-- 底部分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"
        android:background="@color/divider" />

</RelativeLayout> 